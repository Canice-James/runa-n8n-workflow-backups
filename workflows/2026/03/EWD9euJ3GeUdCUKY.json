      {
        "parameters": {
          "jsCode": "// Baserow Brand Info is the source of truth for IPs. All brands are read:\n// \"IP Checks Enabled\" only controls alerts, not score collection.\n// Matched to Postgres `mailings` on brand name + type (Mail1/Mail2).\n// Brand code isn't unique (Ignition and IgnitionAUS are both IGN), so the\n// Baserow `Name` field is the key, stored as mailings.brand_name.\nconst brands = $input.all().map(i => i.json);\nif (brands.length === 0) {\n  // Never sync an empty list: that would switch off every mailing.\n  throw new Error('Baserow returned no brands; skipping mailings sync.');\n}\n\nconst rows = [];\nfor (const b of brands) {\n  const brand_name = String(b.Name ?? '').trim();\n  if (!brand_name) continue;\n  for (const type of ['Mail1', 'Mail2']) {\n    const ip_address = String(b[`${type} IP Address`] ?? '').trim();\n    if (ip_address) rows.push({ brand_name, type, ip_address });\n  }\n}\n\nif (rows.length === 0) throw new Error('No mailing rows built from Baserow Brand Info.');\nreturn [{ json: { rows } }];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          368,
          -512
        ],
        "id": "66821802-b737-4b6d-8847-a024a375be65",
        "name": "Build mailing list"
      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH src AS (\n  SELECT * FROM json_to_recordset($1::json) AS x(brand_name text, type text, ip_address text)\n),\nupdated AS (\n  -- IP changed in Baserow -> update Postgres\n  UPDATE mailings m\n  SET ip_address = s.ip_address\n  FROM src s\n  WHERE m.brand_name = s.brand_name\n    AND m.type = s.type\n    AND m.ip_address IS DISTINCT FROM s.ip_address\n  RETURNING m.name\n),\ndisabled AS (\n  -- Brand inactive or IP blank in Baserow -> clear the IP (history kept; ETL skips NULLs)\n  UPDATE mailings m\n  SET ip_address = NULL\n  WHERE m.ip_address IS NOT NULL\n    AND NOT EXISTS (SELECT 1 FROM src s WHERE s.brand_name = m.brand_name AND s.type = m.type)\n  RETURNING m.name\n)\nSELECT\n  (SELECT json_agg(name) FROM updated)  AS updated,\n  (SELECT json_agg(name) FROM disabled) AS disabled,\n  -- In Baserow but no Postgres row yet: add these to `mailings` with their hostname\n  (SELECT json_agg(s.brand_name || ' ' || s.type) FROM src s\n     WHERE NOT EXISTS (SELECT 1 FROM mailings m WHERE m.brand_name = s.brand_name AND m.type = s.type)\n  ) AS missing_in_postgres;",
          "options": {
            "queryReplacement": "={{ [ JSON.stringify($json.rows) ] }}"
          }
        },

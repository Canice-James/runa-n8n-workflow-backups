      {
        "parameters": {
          "jsCode": "// Build IP -> mailing name(s) from the source query.\n// (Pairing by index breaks as soon as the If node drops items.)\nconst ipToMailings = new Map();\nfor (const row of $('Select rows from a table1').all()) {\n  const ip = String(row.json.ip_address ?? '').trim();\n  if (!ip) continue;\n  if (!ipToMailings.has(ip)) ipToMailings.set(ip, new Set());\n  ipToMailings.get(ip).add(row.json.name);\n}\n\n// Look back several days: Everest's trend lags, and the upsert de-dupes,\n// so missed runs self-heal on the next run.\nconst LOOKBACK_DAYS = 7;\nconst cutoff = new Date();\ncutoff.setDate(cutoff.getDate() - LOOKBACK_DAYS);\nconst cutoffDate = cutoff.toISOString().slice(0, 10);\n\nconst latest = new Map();\nfor (const item of $input.all()) {\n  const results = item.json.results ?? {};\n  const ip = String(results.ip ?? '').trim();\n  const mailings = ipToMailings.get(ip);\n  if (!ip || !mailings) continue;\n\n  for (const point of results.sender_score?.trend ?? []) {\n    const score = point.value ?? null;\n    const date = String(point.day ?? '').slice(0, 10); // handles \"YYYY-MM-DD\" and ISO timestamps\n    if (score === null || !/^\\d{4}-\\d{2}-\\d{2}$/.test(date) || date < cutoffDate) continue;\n\n    for (const mailing of mailings) {\n      const key = `${mailing}|${ip}|${date}`;\n      const existing = latest.get(key);\n      if (!existing || score > existing.score) {\n        latest.set(key, { mailing, ip_address: ip, score, date });\n      }\n    }\n  }\n}\n\nreturn [...latest.values()].map(json => ({ json }));"
        },

    {
      "parameters": {
        "jsCode": "const inputItems = $input.all().entries();\nconst output = [];\n\n// Get yesterday's date as YYYY-MM-DD string (no timezone issues)\nconst yesterday = new Date();\nyesterday.setDate(yesterday.getDate() - 1);\nconst cutoffDate = yesterday.toLocaleDateString('en-CA'); // en-CA gives YYYY-MM-DD format\n\n// Use a map to track the latest score per mailing+ip+date combo\nconst latestRecords = new Map();\n\nfor (const [index, item] of inputItems) {\n  const mailing = $('Select rows from a table').all()[index].json.name;\n  const ip_address = item.json.results.ip;\n  const history = item.json.results.sender_score.trend || [];\n\n  for (const row of history) {\n    const score = row.value ?? null;\n    const date = (row.day || '');\n\n    if (score !== null && date && date >= cutoffDate) {\n      const key = `${mailing}|${ip_address}|${date}`;\n      const existing = latestRecords.get(key);\n\n      // Keep the record with the highest score if duplicates exist\n      if (!existing || score > existing.score) {\n        latestRecords.set(key, { mailing, ip_address, score, date });\n      }\n    }\n  }\n}\n\nfor (const record of latestRecords.values()) {\n  output.push({ json: record });\n}\n\nreturn output;"
      },

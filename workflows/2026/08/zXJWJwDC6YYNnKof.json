      {
        "parameters": {
          "formTitle": "MarTech Diffusion",
          "formDescription": "Send a Markdown announcement to Mattermost users and channels.",
          "formFields": {
            "values": [
              {
                "fieldLabel": "Markdown message",
                "fieldType": "textarea",
                "fieldName": "message",
                "placeholder": "# Announcement\\n\\nWrite Markdown here",
                "requiredField": true
              },
              {
                "fieldLabel": "Recipients",
                "fieldType": "textarea",
                "fieldName": "recipients",
                "placeholder": "@scaicedo, #marketing, or a channel ID",
                "requiredField": true
              }
            ]
          },
          "responseMode": "lastNode",
          "options": {
            "appendAttribution": true,
            "buttonLabel": "Send announcement",
            "path": "martech-diffusion-form"
          }
        },
        "id": "3c56b811-746b-414d-aadf-d870267e73d1",
        "name": "Form Trigger",
        "type": "n8n-nodes-base.formTrigger",
        "typeVersion": 2.6,
        "position": [
          240,
          224
        ],
        "webhookId": "d130d8ab-7734-4370-840e-a8c426831bdb"
      },
      {
        "parameters": {
          "jsCode": "const input = $input.first().json;\nconst payload = input.body && typeof input.body === 'object' ? input.body : input;\nconst knownChannelIds = { 'martech-automated-wikis': 'fj4khgjccfnb5g9s3cbq9fj3ar','martech-leadership':'asr6e1kz7jffxbymp8t57cojuc','markops-snr-leadership':'gp69grmkabn39jgpzbi79woibe','markops-leadership-room':'5nup6aug7idmzrm5qtb4xgm5eo','col-team':'fkb6frpfb3bafgiopqi8m1hrtr','markops-specialist':'9wjgoophribbtrnkyyquxt55kc','markops':'gzqrikofstnhzrsb5i5prgzogo','markops-community':'wyrr1wh4qt8ypxf5b9asith8dc' };\nconst parseList = (value, field) => {\n  if (value === undefined || value === null || value === '') return [];\n  if (Array.isArray(value)) return value;\n  if (typeof value !== 'string') throw new Error(field + ' must be a string or array');\n  const trimmed = value.trim();\n  if (!trimmed) return [];\n  if (trimmed.startsWith('[')) return JSON.parse(trimmed);\n  return trimmed.split(',').map((item) => item.trim()).filter(Boolean);\n};\nconst message = typeof payload.message === 'string' ? payload.message : '';\nif (!message.trim()) throw new Error('message is required and must be Markdown text');\nlet recipients;\nlet userIds;\nlet channelIds;\ntry {\n  recipients = parseList(payload.recipients, 'recipients');\n  userIds = parseList(payload.userIds, 'userIds');\n  channelIds = parseList(payload.channelIds, 'channelIds');\n} catch (error) {\n  throw new Error('Invalid recipient input: ' + error.message);\n}\nconst output = [];\nconst seen = new Set();\nconst add = (route, value, destinationType, destinationId, original) => {\n  if (typeof value !== 'string' || !value.trim()) throw new Error('Recipient values must be non-empty strings');\n  const normalized = value.trim();\n  const key = route + ':' + normalized.toLowerCase();\n  if (seen.has(key)) return;\n  seen.add(key);\n  output.push({ json: { message, original: original || normalized, destinationValue: normalized, destinationType, destinationId, routeIndex: route, preflightError: null } });\n};\nfor (const recipient of recipients) {\n  if (typeof recipient !== 'string' || !recipient.trim()) throw new Error('Recipient values must be non-empty strings');\n  const value = recipient.trim();\n  if (value.startsWith('@')) add(0, value.slice(1), 'user', null, value);\n  else if (value.startsWith('#')) {\n    const channelName = value.slice(1);\n    const knownId = knownChannelIds[channelName.toLowerCase()];\n    if (knownId) add(3, knownId, 'channel', knownId, value);\n    else add(1, channelName, 'channel', null, value);\n  } else if (/^[a-z0-9]{26}$/.test(value)) add(3, value, 'channel', value, value);\n  else throw new Error('Recipients must start with @ or #, or be a 26-character channel ID: ' + value);\n}\nfor (const id of userIds) add(2, id, 'user', id, id);\nfor (const id of channelIds) add(3, id, 'channel', id, id);\nif (!output.length) throw new Error('At least one recipient is required');\nconst expectedCount = output.length;\nreturn output.map((item) => ({ json: { ...item.json, expectedCount } }));"
        },

      {
        "parameters": {
          "jsCode": "const items = $input.all().map((item) => item.json);\nconst expectedCount = items[0]?.expectedCount || 0;\nconst unresolved = items.filter((item) => item.preflightError || !item.destinationId).map((item) => ({ recipient: item.original, error: item.preflightError || 'Destination did not resolve' }));\nif (items.length !== expectedCount || unresolved.length) {\n  return [{ json: { status: 'rejected', deliveryReady: false, unresolved, delivered: 0 } }];\n}\nreturn items.map((item) => ({ json: { ...item, deliveryReady: true } }));"
        },

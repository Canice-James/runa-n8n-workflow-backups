            {
              "color": "#FF0000",
              "fallback": "MAP Jira sync failed",
              "footer": "",
              "text": "={{ (() => {\n  const b = (s) => String.fromCharCode(42, 42) + s + String.fromCharCode(42, 42);\n  const payload = $('Error Trigger').item.json;\n  const wf = payload.workflow || {};\n  const exec = payload.execution || {};\n  const errObj = exec.error || {};\n  let reason = String(errObj.message || 'n8n workflow failed').replace(/\\[line \\d+\\]/gi, '').trim();\n  return [\n    '@scaicedo',\n    b('Workflow:') + ' ' + (wf.name || '') + ' (`' + (wf.id || '') + '`)',\n    b('Failed node:') + ' `' + (exec.lastNodeExecuted || '') + '`',\n    b('Reason:') + ' ' + reason,\n    b('Execution:') + ' ' + (exec.url || ''),\n    b('Time:') + ' ' + $now.toISO()\n  ].join('\\n');\n})() }}",
              "thumb_url": "https://www.freeiconspng.com/uploads/recycle-icon-png-18.png",
              "title": ":x: MAP Jira Sync Failed"
            }
          ],
          "channelId": "71s7kcpk3pfrbgtf1oxyn9tr6o",
